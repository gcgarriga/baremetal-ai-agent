# Copy this file to .env and replace the placeholder token before running.
GITHUB_TOKEN=replace-with-github-token

# Optional settings. These match the defaults in baremetal_agent/config.py.
AGENT_API_URL=https://models.github.ai/inference/chat/completions
AGENT_MODEL=openai/gpt-4.1
AGENT_MAX_ITERATIONS=10
AGENT_WORKING_DIR=.
AGENT_VERBOSE=false
AGENT_STREAM=false

# Set this in your shell before launch to load a different env file.
# AGENT_DOTENV=/absolute/path/to/custom.env
